# Files that belong in the repository but NOT in the plugin zip.
#
# `git archive` honours these, which is what makes the release zip in RELEASE.md
# a single command with nothing to remember — the zip is exactly the tagged
# commit minus the lines below, so it cannot quietly drift from what was
# reviewed.
/.gitattributes  export-ignore
/.gitignore      export-ignore
/CONTRIBUTING.md export-ignore
/RELEASE.md      export-ignore
